OLLAMA_MODEL=gemma4:e4b
OLLAMA_HOST=http://localhost:11434

# Optional per-role model overrides (each falls back to OLLAMA_MODEL if unset).
#   QUERY_MODEL  — precision/selection calls + agent loops (page/source selection)
#   INGEST_MODEL — wiki page synthesis during ingest
#   FAST_MODEL   — lightweight maintenance (lint)
QUERY_MODEL=
INGEST_MODEL=
FAST_MODEL=

# PDF/DOCX → Markdown conversion (src/md_convert.py). REWRITE_MODEL structures
# extracted PDF text without rewording, so a small fixed model is ~8x faster at
# equal fidelity and is independent of OLLAMA_MODEL. OCR_MODEL must be vision-capable.
REWRITE_MODEL=LiquidAI/lfm2.5-1.2b-instruct:latest
OCR_MODEL=deepseek-ocr:3b
PDF_DPI=150
TAVILY_API_KEY=
MAX_INGEST_CHARS=40000

# Multi-database root. Each database is an isolated subtree:
#   $DATA_ROOT/<db>/{raw,chunks,index,wiki}
# Users + per-user DB allowlists live in $DATA_ROOT/users.json (bcrypt hashes).
DATA_ROOT=data

# Retrieval. EMBED_MODEL drives the semantic arm (Stage C, local Ollama /api/embed);
# changing it invalidates the vector cache — re-run scripts/backfill_embeddings.py.
EMBED_MODEL=bge-m3

# Stage D cross-encoder reranker (src/rerank.py). OPTIONAL: without the extra
# (`uv sync --extra rerank`) or the GGUF, retrieval degrades to plain RRF fusion.
# Only the Deep answer paths rerank; browsing/per-keystroke search never does.
RERANK_ENABLED=1
RERANK_MODEL=models/bge-reranker-v2-m3-Q8_0.gguf
RERANK_CANDIDATES=30
RERANK_THREADS=0

# Stage E calibrated abstention (src/calibrate.py). Per-DB threshold τ comes from
# scripts/calibrate_abstention.py (data/<DB>/index/calibration.json). A DB without one
# never abstains (fail-safe). ABSTAIN_ENABLED=0 turns it off; ABSTAIN_TAU_DEFAULT is an
# optional fallback τ for uncalibrated DBs (leave unset to keep them answering).
ABSTAIN_ENABLED=1
# ABSTAIN_TAU_DEFAULT=

# Wiki Explorer → Graph. `legacy` = the vis.js typed graph; `neural` = the canvas
# neural renderer (src/graph_widget.py). Both draw the same typed graph;
# the default stays `legacy` until the neural one has parity.
GRAPH_RENDERER=legacy
# Backdrop behind the wiki graph canvas: `galaxy` (Hubble image shipped in
# src/assets/graph/, credit NASA/ESA — see NOTICE) or `none` for flat black.
# Decorative only; the graph, its analytics and its interactions are identical.
GRAPH_BACKDROP=galaxy
# Guardrail: above this the payload keeps the best-connected nodes and flags
# `truncated` (the client force layout degrades before the analytics do).
GRAPH_MAX_NODES=4000

# Deep chat (Chat → Deep mode)
CHAT_MIN_SEARCHES=3
CHAT_MIN_WORDS=300
CHAT_MIN_SOURCES=2
CHAT_MAX_ITERATIONS=25
CHAT_NUDGE_AT=10
CHAT_LLM_TIMEOUT=180

# Deep researcher (Research page)
RESEARCH_MIN_SEARCHES=6
RESEARCH_MIN_WORDS=600
RESEARCH_MIN_URLS=4
RESEARCH_MAX_ITERATIONS=40
RESEARCH_NUDGE_AT=18
RESEARCH_PARALLELISM=4
RESEARCH_LLM_TIMEOUT=300
